# --- API Auth ---
WORKBENCH_API_KEY=local-dev-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/style_workbench

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=style-workbench

# --- AI Vendors ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
